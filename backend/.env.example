# ========================================================
# SONARX BACKEND ENVIRONMENT CONFIGURATION (SAMPLE)
# Copy this file to backend/.env for local overrides
# ========================================================

# Host and Port
HOST=0.0.0.0
PORT=8000

# Optional Geocoding API Configuration (For reverse place-name lookup)
# Options: opencage | locationiq | mock
GEOCODING_PROVIDER=opencage
GEOCODING_API_KEY=

# Neural Model Path
MODEL_PATH=./models/best.onnx
CONFIDENCE_THRESHOLD=0.25
