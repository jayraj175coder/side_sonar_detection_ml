# ========================================================
# SONARX FRONTEND ENVIRONMENT CONFIGURATION (SAMPLE)
# Copy this file to frontend/.env for local overrides
# ========================================================

# Default geospatial tile provider:
# Options: offline_grid | carto_osm | mapbox | google_maps
VITE_MAP_PROVIDER=offline_grid

# Optional API keys for enhanced tile imagery:
VITE_MAPBOX_TOKEN=
VITE_GOOGLE_MAPS_KEY=
