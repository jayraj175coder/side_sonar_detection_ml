# ========================================================
# SONARX ENVIRONMENT CONFIGURATION (SAMPLE TEMPLATE)
# Copy this file to .env and configure your local settings.
# NEVER commit real API keys or credentials to version control.
# ========================================================

# ── Frontend Map & Geospatial Services (Optional) ──
# Supported providers: offline_grid, carto_osm, mapbox, google_maps, opencage, locationiq
VITE_MAP_PROVIDER=offline_grid
VITE_MAPBOX_TOKEN=
VITE_GOOGLE_MAPS_KEY=

# ── Backend Geocoding & Oceanographic Services (Optional) ──
GEOCODING_PROVIDER=opencage
GEOCODING_API_KEY=
PORT=8000
HOST=0.0.0.0
